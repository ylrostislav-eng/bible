# Copy this file to .env in apps/api for local development

DATABASE_URL="postgresql://bible_arena:bible_arena@localhost:5432/bible_arena?schema=public"
REDIS_URL="redis://localhost:6379"

PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Get this from @BotFather
# Токен бота. Пока пуст — приложение НИЧЕГО не отправляет в Telegram.
TELEGRAM_BOT_TOKEN=
# Адрес Bot API. Меняется только чтобы направить тесты на локальную
# заглушку — иначе проверить доставку можно лишь написав живым людям.
# На боевом сервере эта переменная должна отсутствовать или содержать
# именно этот адрес: с чужим адресом бот молча пишет в никуда.
TELEGRAM_API_BASE=https://api.telegram.org

# Адрес мини-приложения — из него собирается кнопка «Открыть вызов» под
# уведомлением. Пусто — берётся CORS_ORIGIN. Кнопку Telegram показывает
# только для https, поэтому локально её не будет.
WEB_APP_URL=

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=15m

# Comma-separated Telegram user ids allowed to read error telemetry
# (GET/PATCH /telemetry/reports). Leave empty to disable the endpoints.
ADMIN_TELEGRAM_IDS=

# Explicit opt-in for /auth/dev-login (fixed test accounts, no Telegram
# needed). Only takes effect outside production regardless of this flag —
# set true here for local development, leave unset/false everywhere else.
ENABLE_DEV_LOGIN=true
