# Copy this file to .env in apps/api for local development

DATABASE_URL="postgresql://bible_arena:bible_arena@localhost:5432/bible_arena?schema=public"
REDIS_URL="redis://localhost:6379"

PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Get this from @BotFather
TELEGRAM_BOT_TOKEN=

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=30d

# Comma-separated Telegram user ids allowed to read error telemetry
# (GET/PATCH /telemetry/reports). Leave empty to disable the endpoints.
ADMIN_TELEGRAM_IDS=
