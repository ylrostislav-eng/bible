generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A player account, created automatically on first Telegram Mini App launch.
/// `nickname` is null until the user completes onboarding.
model User {
  id String @id @default(cuid())

  telegramId       BigInt  @unique
  telegramUsername String?

  nickname  String? @unique
  avatarUrl String?
  country   String?
  language  String  @default("ru")

  level      Int @default(1)
  experience Int @default(0)
  coins      Int @default(0)
  rating     Int @default(1000)

  gamesPlayed Int @default(0)
  gamesWon    Int @default(0)
  gamesLost   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameParticipations GameParticipant[]

  @@index([rating])
  @@map("users")
}

enum Testament {
  OLD
  NEW
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  APPROVED
}

/// A single quiz question. `options` always has exactly 4 entries;
/// `correctIndex` points into that array.
model Question {
  id String @id @default(cuid())

  text         String
  options      String[]
  correctIndex Int
  explanation  String

  testament Testament
  book      String
  chapter   Int?
  verses    String?
  topic     String?

  difficulty Difficulty     @default(MEDIUM)
  source     String?
  status     QuestionStatus @default(APPROVED)

  usageCount Int @default(0)
  errorCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers GameAnswer[]

  @@index([testament, difficulty, status])
  @@map("questions")
}

enum GameMode {
  SOLO
  DUEL
}

enum GameSessionStatus {
  WAITING_FOR_OPPONENT
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/// One played game — solo or a duel between two participants. Rooms/
/// tournaments will reuse the same participants model with more than two
/// rows per session.
model GameSession {
  id String @id @default(cuid())

  mode          GameMode          @default(SOLO)
  status        GameSessionStatus @default(IN_PROGRESS)
  questionCount Int

  /// 6-character code used to join a DUEL; null for SOLO sessions.
  inviteCode String? @unique

  /// Index (0-based) of the question currently being answered.
  currentOrder Int @default(0)
  /// Server timestamp when the current question was presented — the only
  /// source of truth for speed-based scoring; client-reported timings are
  /// never trusted.
  currentQuestionStartedAt DateTime?
  /// Seconds allowed per question in a duel; unused for SOLO.
  timeLimitSeconds Int @default(15)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  participants GameParticipant[]
  answers      GameAnswer[]

  @@map("game_sessions")
}

/// One player's presence and running score within a session. SOLO sessions
/// have exactly one; DUEL sessions have exactly two.
model GameParticipant {
  id        String      @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  correctCount Int @default(0)
  score        Int @default(0)
  /// Current streak of consecutive correct answers, reset to 0 on a miss.
  streak Int @default(0)

  xpEarned    Int @default(0)
  coinsEarned Int @default(0)

  answers GameAnswer[]

  @@unique([sessionId, userId])
  @@map("game_participants")
}

/// One question served to one participant, in order. Created up front for
/// the whole session (per participant); filled in as they answer. In a duel
/// both participants get their own row for the same `questionId`/`order`.
model GameAnswer {
  id            String          @id @default(cuid())
  sessionId     String
  session       GameSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String
  participant   GameParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question        @relation(fields: [questionId], references: [id])

  order         Int
  selectedIndex Int?
  isCorrect     Boolean?
  answeredAt    DateTime?
  timeTakenMs   Int?
  /// Points this answer contributed to the participant's score (duels only;
  /// solo scoring is flat and doesn't need a per-question breakdown).
  scoreDelta Int?

  @@unique([participantId, order])
  @@map("game_answers")
}
