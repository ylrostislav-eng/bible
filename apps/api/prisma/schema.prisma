generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A player account, created automatically on first Telegram Mini App launch.
/// `nickname` is null until the user completes onboarding.
model User {
  id String @id @default(cuid())

  telegramId       BigInt  @unique
  telegramUsername String?

  nickname  String? @unique
  avatarUrl String?
  country   String?
  language  String  @default("ru")

  level      Int @default(1)
  experience Int @default(0)
  coins      Int @default(0)
  /// Drives both the leaderboard and the title ladder (see TITLES in
  /// packages/shared) — can go negative, titles account for that.
  rating     Int @default(100)

  /// All completed games, solo and duel alike — kept for potential future
  /// use but not shown on its own; the profile's duel stats card uses
  /// `duelsPlayed`/`gamesWon`/`gamesLost` instead, since those are the only
  /// counters with a win/loss outcome to begin with.
  gamesPlayed Int @default(0)
  gamesWon    Int @default(0)
  gamesLost   Int @default(0)
  /// A duel where both sides tied — the third possible outcome alongside
  /// `gamesWon`/`gamesLost`. `duelsPlayed` always equals the sum of all
  /// three.
  gamesDrawn  Int @default(0)
  /// Completed duels only (win, loss, or draw) — the denominator for the
  /// profile's duel stats card. Unlike `gamesPlayed`, never incremented by
  /// solo games.
  duelsPlayed Int @default(0)

  /// Consecutive days with at least one completed chapter check-up.
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime? @db.Date

  /// Streak-goal feature: the day-target the user picked (7/14/30/50), or
  /// null if none set. `streakGoalRewardedAt` is set once the coin reward
  /// for reaching it has been granted — a goal is a one-time achievement,
  /// not re-granted after a later streak reset and regrowth past the same
  /// number. Picking a new goal clears it (unless the current streak
  /// already meets the new goal, which grants immediately).
  streakGoalDays       Int?
  streakGoalRewardedAt DateTime?

  /// Last time the app was opened at all (touched on every profile fetch) —
  /// separate from `lastActivityDate`, which only tracks the daily-streak
  /// activity. Used for the inactivity rating decay.
  lastActiveAt DateTime @default(now())

  /// Daily cap on rating earned from duel wins, so a title can't be farmed
  /// by chain-dueling. Reset whenever `duelRatingCapDate` isn't today.
  duelRatingWinsToday Int       @default(0)
  duelRatingCapDate   DateTime? @db.Date

  /// Separate daily rating cap for room matches (3+ players) — tracks raw
  /// points earned today, not a win count, since room rewards are
  /// percentile-based rather than win/loss. Clips the overflow of a single
  /// game's reward rather than zeroing it — see `RoomsService.applyRoomRewards`.
  roomRatingPointsToday Int       @default(0)
  roomRatingCapDate     DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameParticipations   GameParticipant[]
  chapterCheckSessions ChapterCheckSession[]

  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  /// One row per direction of a friendship — see `Friendship` doc comment.
  friendships            Friendship[]    @relation("FriendshipOwner")

  /// Bans are scoped to the leader who issued them — a user banned from one
  /// leader's rooms can still freely join everyone else's.
  roomBansIssued   RoomBan[] @relation("RoomBansIssued")
  roomBansReceived RoomBan[] @relation("RoomBansReceived")

  @@index([rating])
  @@map("users")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// A friend request from one user to another. Kept (not deleted) after
/// acceptance/decline so a re-send after a decline has something to upsert
/// onto instead of hitting the unique constraint — see `FriendsService.sendRequest`.
model FriendRequest {
  id String @id @default(cuid())

  fromUserId String
  fromUser   User   @relation("SentFriendRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User   @relation("ReceivedFriendRequests", fields: [toUserId], references: [id], onDelete: Cascade)

  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@map("friend_requests")
}

/// Friendship is stored as two rows, one per direction (userId -> friendId
/// and friendId -> userId), created together in a transaction on accept.
/// Trades a little duplication for a trivial "my friends" query
/// (`where userId = me`) instead of an OR-across-both-columns query.
model Friendship {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation("FriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friendId String

  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([friendId])
  @@map("friendships")
}

/// A quiz question checking comprehension of one specific Bible chapter
/// (distinct from the free-form trivia bank used by solo/duel games).
model ChapterQuestion {
  id String @id @default(cuid())

  bookId  Int
  chapter Int

  text         String
  options      String[]
  correctIndex Int
  explanation  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers ChapterCheckAnswer[]

  @@index([bookId, chapter])
  @@map("chapter_questions")
}

/// One attempt at the comprehension check for a chapter. Timing is tracked
/// server-side (`currentQuestionStartedAt` + `timeLimitSeconds`) so the
/// client can't just wait indefinitely before answering.
model ChapterCheckSession {
  id String @id @default(cuid())

  userId  String
  bookId  Int
  chapter Int

  totalQuestions Int
  correctCount   Int @default(0)

  currentQuestionStartedAt DateTime?
  timeLimitSeconds         Int       @default(20)
  completedAt              DateTime?
  /// True if this completion actually paid out rating/XP/coins — false for
  /// a practice replay still within the 7-day cooldown for this chapter.
  rewarded                 Boolean   @default(false)

  createdAt DateTime @default(now())

  user    User                 @relation(fields: [userId], references: [id])
  answers ChapterCheckAnswer[]

  @@index([userId])
  @@map("chapter_check_sessions")
}

model ChapterCheckAnswer {
  id String @id @default(cuid())

  sessionId  String
  questionId String
  /// Fixed presentation order, chosen when the session starts.
  order      Int

  answered      Boolean @default(false)
  selectedIndex Int?
  correct       Boolean @default(false)
  timeExpired   Boolean @default(false)
  timeTakenMs   Int?

  /// This question's 4 options, shuffled once when the session starts (so
  /// the answer position can't be memorized), with `correctIndex` remapped
  /// to match. The underlying `ChapterQuestion.options` order is untouched.
  shuffledOptions      String[]
  shuffledCorrectIndex Int      @default(0)

  createdAt DateTime @default(now())

  session  ChapterCheckSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question ChapterQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@map("chapter_check_answers")
}

enum Testament {
  OLD
  NEW
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  APPROVED
}

/// One verse of the Synodal translation. `bookId` is the standard 1-66
/// canonical book number (see `BIBLE_BOOKS` in packages/shared) — book
/// metadata (name, testament, chapter count) lives there, not here.
model BibleVerse {
  id Int @id @default(autoincrement())

  bookId  Int
  chapter Int
  verse   Int
  text    String

  @@unique([bookId, chapter, verse])
  @@index([bookId, chapter])
  @@map("bible_verses")
}

/// A single quiz question. `options` always has exactly 4 entries;
/// `correctIndex` points into that array.
model Question {
  id String @id @default(cuid())

  text         String
  options      String[]
  correctIndex Int
  explanation  String

  testament Testament
  book      String
  chapter   Int?
  verses    String?
  topic     String?

  difficulty Difficulty     @default(MEDIUM)
  source     String?
  status     QuestionStatus @default(APPROVED)

  usageCount Int @default(0)
  errorCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers GameAnswer[]

  @@index([testament, difficulty, status])
  @@map("questions")
}

enum GameMode {
  SOLO
  DUEL
  ROOM
}

enum GameSessionStatus {
  WAITING_FOR_OPPONENT
  /// ROOM-only: participants have joined and are toggling ready; the leader
  /// starts the match once everyone (but themselves) is ready.
  LOBBY
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum RoomVisibility {
  /// Listed to everyone in-app; anyone can join freely, no password.
  PUBLIC
  /// Hidden from the public list; joining requires the room's `password`.
  PRIVATE
}

/// One played game — solo, a duel between two participants, or a room with
/// up to `ROOM_MAX_PARTICIPANTS` players. Rooms reuse the same participants
/// model with more than two rows per session.
model GameSession {
  id String @id @default(cuid())

  mode          GameMode          @default(SOLO)
  status        GameSessionStatus @default(IN_PROGRESS)
  questionCount Int

  /// 6-character code used to join a DUEL or ROOM; null for SOLO sessions.
  /// For a friend-challenge DUEL it's a fallback/share code, but only
  /// `targetUserId` (when set) may actually join via it — see
  /// `DuelService.join`. For a ROOM it's always usable to join (a PRIVATE
  /// room additionally requires `password`).
  inviteCode String? @unique

  /// Set only when this DUEL was created as a direct challenge to a
  /// specific friend (`DuelService.challenge`) rather than an open invite
  /// code anyone can join with.
  targetUserId String?

  /// ROOM-only fields below — null/unused for SOLO and DUEL.
  roomName        String?
  visibility      RoomVisibility?
  /// Auto-generated, non-colliding-with-recent-passwords string required to
  /// join a PRIVATE room; null for PUBLIC rooms (and non-rooms).
  password        String?
  /// The room's creator — controls kick/ban/start. Also has a
  /// `GameParticipant.isLeader` row for the same user, kept in sync.
  leaderId        String?
  maxParticipants Int?

  /// Index (0-based) of the question currently being answered.
  currentOrder Int @default(0)
  /// Server timestamp when the current question was presented — the only
  /// source of truth for speed-based scoring; client-reported timings are
  /// never trusted.
  currentQuestionStartedAt DateTime?
  /// Seconds allowed per question in a duel/room; unused for SOLO.
  timeLimitSeconds Int @default(15)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  participants GameParticipant[]
  answers      GameAnswer[]

  @@index([targetUserId, status])
  @@index([mode, status, visibility])
  @@map("game_sessions")
}

/// One player's presence and running score within a session. SOLO sessions
/// have exactly one; DUEL sessions have exactly two.
model GameParticipant {
  id        String      @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ROOM-only: display order in the lobby/game participant list.
  joinedAt DateTime @default(now())

  correctCount Int @default(0)
  score        Int @default(0)
  /// Current streak of consecutive correct answers, reset to 0 on a miss.
  streak Int @default(0)

  xpEarned    Int @default(0)
  coinsEarned Int @default(0)
  /// Rating actually applied for this game (duels/rooms only; solo never
  /// touches rating). Zero if `ratingCapped` — the daily cap clipped it.
  ratingDelta  Int     @default(0)
  ratingCapped Boolean @default(false)

  /// ROOM-only: the creator, who controls kick/ban/start. Mirrors
  /// `GameSession.leaderId` for this row's `userId`.
  isLeader Boolean @default(false)
  /// ROOM-only: toggled by every non-leader participant before the leader
  /// can start the match. Always false once the room leaves LOBBY.
  isReady  Boolean @default(false)

  answers GameAnswer[]

  @@unique([sessionId, userId])
  @@map("game_participants")
}

/// A leader-scoped block: `bannedUserId` can never join any ROOM led by
/// `leaderId` again (existing rooms they're already in are unaffected — a
/// ban only blocks future joins). Independent of other leaders' rooms.
model RoomBan {
  id String @id @default(cuid())

  leaderId String
  leader   User   @relation("RoomBansIssued", fields: [leaderId], references: [id], onDelete: Cascade)

  bannedUserId String
  bannedUser   User   @relation("RoomBansReceived", fields: [bannedUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([leaderId, bannedUserId])
  @@map("room_bans")
}

/// One question served to one participant, in order. Created up front for
/// the whole session (per participant); filled in as they answer. In a duel
/// both participants get their own row for the same `questionId`/`order`.
model GameAnswer {
  id            String          @id @default(cuid())
  sessionId     String
  session       GameSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String
  participant   GameParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question        @relation(fields: [questionId], references: [id])

  order         Int
  selectedIndex Int?
  isCorrect     Boolean?
  answeredAt    DateTime?
  timeTakenMs   Int?
  /// Points this answer contributed to the participant's score (duels only;
  /// solo scoring is flat and doesn't need a per-question breakdown).
  scoreDelta Int?

  /// This question's 4 options, shuffled independently per participant when
  /// the round is set up (so the answer position can't be memorized or
  /// called out to a duel opponent), with `correctIndex` remapped to match.
  /// The underlying `Question.options` order is untouched.
  shuffledOptions      String[]
  shuffledCorrectIndex Int      @default(0)

  @@unique([participantId, order])
  @@map("game_answers")
}
