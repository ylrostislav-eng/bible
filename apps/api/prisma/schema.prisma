generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A player account, created automatically on first Telegram Mini App launch.
/// `nickname` is null until the user completes onboarding.
model User {
  id String @id @default(cuid())

  telegramId       BigInt  @unique
  telegramUsername String?

  nickname  String? @unique
  avatarUrl String?
  country   String?
  language  String  @default("ru")

  /// Self-declared age band, asked once during onboarding. Null only for
  /// accounts created before this existed — they keep full access, and the
  /// app asks the next time the profile screen is opened.
  ageBand             AgeBand?
  /// Set when the guardian screen shown for the CHILD band was accepted.
  /// Kept as a timestamp rather than a flag so it stays meaningful if the
  /// wording later changes.
  guardianConfirmedAt DateTime?
  /// scrypt hash of the optional guardian PIN (see `users.service.ts`).
  /// While set, leaving the CHILD band requires the PIN — the point is to
  /// stop a child flipping the setting themselves, not to secure anything.
  guardianPinHash     String?

  /// Неугадываемый ключ пригласительной ссылки (`?startapp=ref_<token>`).
  ///
  /// Раньше в ссылке стоял сам `id` пользователя, и это была дыра: параметр
  /// запуска приходит от клиента, подделать его может кто угодно, а для
  /// нового аккаунта приглашение создаёт **взаимную** дружбу без спроса.
  /// То есть, взяв чужой `id` из списка лидеров, можно было завести
  /// свежий аккаунт и стать другом любого игрока — включая ребёнка, —
  /// получив вместе с этим право звать его в игры и видеть, когда он в сети
  /// (на момент находки — ещё и право писать ему в личную переписку,
  /// которой в приложении больше нет).
  ///
  /// Токен случайный, поэтому подставить чужой нельзя: угадать его так же
  /// трудно, как пароль. Раздаёт его сам владелец вместе со ссылкой — это
  /// и есть согласие, которого не хватало.
  ///
  /// Заводится лениво, при первом запросе ссылки: у большинства аккаунтов
  /// его нет и не будет.
  inviteToken         String?   @unique

  level      Int @default(1)
  experience Int @default(0)
  coins      Int @default(0)
  /// Drives both the leaderboard and the title ladder (see TITLES in
  /// packages/shared) — can go negative, titles account for that.
  rating     Int @default(100)

  /// All completed games, solo and duel alike — kept for potential future
  /// use but not shown on its own; the profile's duel stats card uses
  /// `duelsPlayed`/`gamesWon`/`gamesLost` instead, since those are the only
  /// counters with a win/loss outcome to begin with.
  gamesPlayed Int @default(0)
  gamesWon    Int @default(0)
  gamesLost   Int @default(0)
  /// A duel where both sides tied — the third possible outcome alongside
  /// `gamesWon`/`gamesLost`. `duelsPlayed` always equals the sum of all
  /// three.
  gamesDrawn  Int @default(0)
  /// Completed duels only (win, loss, or draw) — the denominator for the
  /// profile's duel stats card. Unlike `gamesPlayed`, never incremented by
  /// solo games.
  duelsPlayed Int @default(0)

  /// Consecutive days with at least one finished game of any kind — solo,
  /// duel, room or chapter check.
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime? @db.Date

  /// Streak-goal feature: the day-target the user picked (7/14/30/50), or
  /// null if none set. `streakGoalRewardedAt` is set once the coin reward
  /// for reaching it has been granted — a goal is a one-time achievement,
  /// not re-granted after a later streak reset and regrowth past the same
  /// number. Picking a new goal clears it (unless the current streak
  /// already meets the new goal, which grants immediately).
  streakGoalDays       Int?
  streakGoalRewardedAt DateTime?

  /// Запас «хранителей серии» из лавки: каждый закрывает один пропущенный
  /// день (см. `packages/shared/src/shop.ts`).
  ///
  /// Тратится сам, при первой игре после пропуска, — нажать кнопку в
  /// пропущенный день некому: игрока в этот день в приложении и не было.
  /// Поэтому это запас, а не разовая покупка «на завтра».
  streakFreezes Int @default(0)

  /// Запас «вторых попыток» на «Слово дня» из лавки.
  ///
  /// Счётчиком рядом с монетами, а не строками в журнале покупок: его
  /// читают и уменьшают на горячем пути (экран слова дня), и считать
  /// остаток выборкой по журналу на каждый заход — лишняя работа ради
  /// числа, которое и так помещается в колонку.
  dailyWordRetries Int @default(0)

  /// The player's own UTC offset, in `Date.prototype.getTimezoneOffset()`
  /// units (positive = behind UTC). Refreshed from a request header on
  /// every profile fetch. Stored rather than passed per-call because a duel
  /// or a room match finishes on the server's own schedule — there's no
  /// request in flight from the player to read a clock off at that moment,
  /// and the streak has to roll over on *their* midnight.
  timezoneOffsetMinutes Int @default(0)

  /// Accessibility settings — see `packages/shared/src/accessibility.ts`.
  /// `questionPace` applies to the solo chapter check-up only: duels and
  /// rooms share one clock between competitors, so a per-player timer there
  /// would be an advantage rather than a setting.
  questionPace QuestionPace @default(NORMAL)
  textScale    TextScale    @default(NORMAL)

  /// Звук — см. `packages/shared/src/sound.ts`. Включено всё: и отклики,
  /// и музыка.
  ///
  /// Музыка сначала была выключена по умолчанию — из опасения, что
  /// незапрошенный звук в транспорте прочтётся как поломка. На практике
  /// вышло иначе: выключенная музыка означает, что её просто не слышит
  /// никто, потому что за настройками не ходят. Опасение снято тем, что
  /// выключить её можно в одно касание — плавающая кнопка с нотой есть на
  /// каждом экране, а не спрятана в настройках.
  soundEnabled   Boolean @default(true)
  musicEnabled   Boolean @default(true)
  hapticsEnabled Boolean @default(true)
  soundVolume    Int     @default(70)
  /// Громкость музыки отдельно от откликов: музыка играет постоянно и
  /// мешает не так, как короткий щелчок, поэтому убавляют именно её.
  musicVolume    Int     @default(60)

  /// Evening reminder when the daily streak is about to lapse. On by
  /// default, off with one tap in settings — and turned off automatically
  /// if Telegram reports the bot was blocked, so a person who walked away
  /// is never messaged again.
  remindersEnabled Boolean   @default(true)
  /// When the last reminder was sent, so at most one goes out per day even
  /// though the sweep runs every few minutes.
  lastReminderAt   DateTime?

  /// Сообщение в Telegram, когда игрока зовут в игру, а приложение у него
  /// закрыто: «такой-то бросает вам вызов» со ссылкой внутрь.
  ///
  /// Отдельный переключатель от `remindersEnabled` намеренно. Это разные
  /// вещи по смыслу: напоминание про серию человек может считать надоедой
  /// и выключить, но остаться при этом доступным для друзей — и наоборот.
  /// Одна кнопка на оба случая заставляла бы выбирать между «меня зовут» и
  /// «мне напоминают».
  ///
  /// Выключается автоматически, если Telegram сообщил о блокировке бота, —
  /// как и напоминания.
  inviteNotificationsEnabled Boolean @default(true)

  /// Разрешил ли человек боту писать ему в личные сообщения.
  ///
  /// Тонкость Telegram: открыть мини-приложение по прямой ссылке можно, ни
  /// разу не заговорив с ботом, — и тогда чата нет, а без чата бот писать
  /// не может. Разрешение спрашивается внутри приложения родным окном
  /// (`requestWriteAccess`), и его ответ хранится здесь.
  ///
  /// Отправку уведомлений этот флаг НЕ загораживает: у тех, кто нажал
  /// Start в боте когда-то давно, он ложно пуст, и запрет по нему отнял бы
  /// у них уведомления. Флаг решает другое — стоит ли **спрашивать**
  /// разрешение ещё раз.
  canWriteToPm Boolean @default(false)

  /// Скрыть имя: везде, где показывался никнейм, остаётся один значок роли.
  ///
  /// Только для гейм-мастера и администраторов — обычному игроку это дало
  /// бы безымянную строку в списках, а вместе с ней способ спрятаться от
  /// того, кто на него пожаловался.
  ///
  /// Скрытие настоящее, а не рисованное: имя не уходит с сервера вовсе
  /// (см. `StaffNameMask`). Спрятанное только в вёрстке, оно осталось бы в
  /// ответе API — то есть на виду у любого, кто откроет консоль.
  hideName Boolean @default(false)

  /// Надетое оформление из лавки: ключ рамки и цвет имени. Хранится
  /// **надетое**, а не купленное, — что куплено, знает `ShopPurchase`.
  ///
  /// Лежит здесь, а не вычисляется из покупок, потому что это читают все
  /// списки игроков разом: рейтинг, «Игроки», лобби. Отдельный запрос за
  /// покупками на каждую строку списка — та самая беда, из-за которой
  /// когда-то переписывали список чатов.
  ///
  /// Значения — из каталога (`SHOP_ITEMS`), а не любые присланные клиентом:
  /// иначе цвет имени становится способом нарисовать себе что угодно.
  avatarFrame String?
  nameColor   String?

  /// Надетые детали личной лампы: пламя, сосуд, сияние.
  ///
  /// Тремя колонками, а не одним JSON: лампу показывают списки игроков —
  /// лобби, экран готовности дуэли, — и разбирать JSON на каждую строку
  /// списка ради трёх строковых ключей незачем.
  ///
  /// Пустое значение — обычная лампа, та же, что была до лавки. Отсутствие
  /// детали это «как у всех», а не «сломано», поэтому значения по
  /// умолчанию тут нет.
  lampFlame  String?
  lampVessel String?
  lampGlow   String?

  /// Last time the app was opened at all (touched on every profile fetch) —
  /// separate from `lastActivityDate`, which only tracks the daily-streak
  /// activity. Used for the inactivity rating decay.
  lastActiveAt DateTime @default(now())

  /// Daily cap on rating earned from duel wins, so a title can't be farmed
  /// by chain-dueling. Reset whenever `duelRatingCapDate` isn't today.
  duelRatingWinsToday Int       @default(0)
  duelRatingCapDate   DateTime? @db.Date

  /// Separate daily rating cap for room matches (3+ players) — tracks raw
  /// points earned today, not a win count, since room rewards are
  /// percentile-based rather than win/loss. Clips the overflow of a single
  /// game's reward rather than zeroing it — see `RoomsService.applyRoomRewards`.
  roomRatingPointsToday Int       @default(0)
  roomRatingCapDate     DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameParticipations   GameParticipant[]
  chapterCheckSessions ChapterCheckSession[]

  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  /// One row per direction of a friendship — see `Friendship` doc comment.
  friendships            Friendship[]    @relation("FriendshipOwner")
  /// The other side of every `Friendship` row naming this user as the
  /// friend — see `Friendship.friend`.
  friendOf               Friendship[]    @relation("FriendshipTarget")

  /// Set by moderation when a complaint is upheld: until this moment the
  /// user can still read and play, but can't reach anyone else — no friend
  /// requests, no duel challenges, no room invites. It used to be a chat
  /// mute; personal messaging is gone, so the sanction moved to every
  /// remaining way of pestering someone. Deliberately time-boxed rather
  /// than permanent — the common case is a heated moment, not a malicious
  /// account.
  mutedUntil DateTime?

  achievements UserAchievement[]
  shopPurchases ShopPurchase[]
  diceMatches   DiceMatchPlayer[]
  aliasMatches AliasMatch[]
  dailyWords   DailyWordAttempt[]
  hotColdDays  HotColdAttempt[]
  hotColdNotes HotColdFeedback[]
  hotColdDuels HotColdDuelPlayer[]

  abuseReportsFiled   AbuseReport[] @relation("AbuseReportsFiled")
  abuseReportsAgainst AbuseReport[] @relation("AbuseReportsAgainst")

  /// Bans are scoped to the leader who issued them — a user banned from one
  /// leader's rooms can still freely join everyone else's.
  roomBansIssued   RoomBan[] @relation("RoomBansIssued")
  roomBansReceived RoomBan[] @relation("RoomBansReceived")


  roomInvitesSent     RoomInvite[] @relation("RoomInvitesSent")
  roomInvitesReceived RoomInvite[] @relation("RoomInvitesReceived")

  declineNoticesFor DeclineNotice[] @relation("DeclineNoticesFor")
  declineNoticesBy  DeclineNotice[] @relation("DeclineNoticesBy")

  @@index([rating])
  @@map("users")
}

/// Уровни и темы слов для Alias — см. `packages/shared/src/alias.ts`.
enum AliasDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AliasCategory {
  PERSON
  PLACE
  EVENT
  OBJECT
  CONCEPT
  PARABLE
  IDIOM
}

enum AliasTestament {
  OLD
  NEW
  BOTH
}

enum QuestionPace {
  NORMAL
  RELAXED
  UNTIMED
}

enum TextScale {
  NORMAL
  LARGE
  XLARGE
}

/// See `packages/shared/src/age.ts` for what each band changes.
enum AgeBand {
  CHILD
  TEEN
  ADULT
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// A friend request from one user to another. Kept (not deleted) after
/// acceptance/decline so a re-send after a decline has something to upsert
/// onto instead of hitting the unique constraint — see `FriendsService.sendRequest`.
model FriendRequest {
  id String @id @default(cuid())

  fromUserId String
  fromUser   User   @relation("SentFriendRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User   @relation("ReceivedFriendRequests", fields: [toUserId], references: [id], onDelete: Cascade)

  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@map("friend_requests")
}

/// Friendship is stored as two rows, one per direction (userId -> friendId
/// and friendId -> userId), created together in a transaction on accept.
/// Trades a little duplication for a trivial "my friends" query
/// (`where userId = me`) instead of an OR-across-both-columns query.
model Friendship {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation("FriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friendId String
  /// Was a bare, unenforced string before — no FK meant the other side of
  /// a friendship could be left pointing at nothing once account deletion
  /// exists. `onDelete: Cascade` here mirrors `user` above: deleting either
  /// side of a friendship removes both directions of the row pair, not
  /// just the half owned by the deleted account.
  friend   User   @relation("FriendshipTarget", fields: [friendId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([friendId])
  @@map("friendships")
}

/// A single direct message between two friends. `conversationKey` is the two
/// user ids sorted and joined with `_` — one shared value per pair regardless
/// of who sent to whom, so a whole thread can be fetched with a single
/// `where conversationKey = ...` instead of an OR-across-both-directions
/// query. Messaging is friends-only (enforced in `ChatService`, not here).

/// A quiz question checking comprehension of one specific Bible chapter
/// (distinct from the free-form trivia bank used by solo/duel games).
model ChapterQuestion {
  id String @id @default(cuid())

  bookId  Int
  chapter Int

  text         String
  options      String[]
  correctIndex Int
  explanation  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers ChapterCheckAnswer[]

  @@index([bookId, chapter])
  @@map("chapter_questions")
}

/// One attempt at the comprehension check for a chapter. Timing is tracked
/// server-side (`currentQuestionStartedAt` + `timeLimitSeconds`) so the
/// client can't just wait indefinitely before answering.
model ChapterCheckSession {
  id String @id @default(cuid())

  userId  String
  bookId  Int
  chapter Int

  totalQuestions Int
  correctCount   Int @default(0)

  currentQuestionStartedAt DateTime?
  timeLimitSeconds         Int       @default(20)
  completedAt              DateTime?
  /// True if this completion actually paid out rating/XP/coins — false for
  /// a practice replay still within the 7-day cooldown for this chapter.
  rewarded                 Boolean   @default(false)

  createdAt DateTime @default(now())

  /// Каскад, как у всех остальных связей с `User`. Раньше здесь стоял
  /// `RESTRICT` по умолчанию — единственный на всю схему, — и из-за него
  /// удаление игрока падало на внешнем ключе: у всякого, кто хоть раз
  /// проверил главу, аккаунт удалить было нельзя.
  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ChapterCheckAnswer[]

  @@index([userId])
  @@map("chapter_check_sessions")
}

model ChapterCheckAnswer {
  id String @id @default(cuid())

  sessionId  String
  questionId String
  /// Fixed presentation order, chosen when the session starts.
  order      Int

  answered      Boolean @default(false)
  selectedIndex Int?
  correct       Boolean @default(false)
  timeExpired   Boolean @default(false)
  timeTakenMs   Int?

  /// This question's 4 options, shuffled once when the session starts (so
  /// the answer position can't be memorized), with `correctIndex` remapped
  /// to match. The underlying `ChapterQuestion.options` order is untouched.
  shuffledOptions      String[]
  shuffledCorrectIndex Int      @default(0)

  createdAt DateTime @default(now())

  session  ChapterCheckSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question ChapterQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@map("chapter_check_answers")
}

enum Testament {
  OLD
  NEW
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  APPROVED
}

/// One verse of the Synodal translation. `bookId` is the standard 1-66
/// canonical book number (see `BIBLE_BOOKS` in packages/shared) — book
/// metadata (name, testament, chapter count) lives there, not here.
model BibleVerse {
  id Int @id @default(autoincrement())

  bookId  Int
  chapter Int
  verse   Int
  text    String

  @@unique([bookId, chapter, verse])
  @@index([bookId, chapter])
  @@map("bible_verses")
}

/// A single quiz question. `options` always has exactly 4 entries;
/// `correctIndex` points into that array.
model Question {
  id String @id @default(cuid())

  text         String
  options      String[]
  correctIndex Int
  explanation  String

  testament Testament
  book      String
  chapter   Int?
  verses    String?
  topic     String?

  difficulty Difficulty     @default(MEDIUM)
  source     String?
  status     QuestionStatus @default(APPROVED)

  usageCount Int @default(0)
  errorCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers GameAnswer[]

  @@index([testament, difficulty, status])
  @@map("questions")
}

enum GameMode {
  SOLO
  DUEL
  ROOM
}

enum GameSessionStatus {
  WAITING_FOR_OPPONENT
  /// ROOM-only: participants have joined and are toggling ready; the leader
  /// starts the match once everyone (but themselves) is ready.
  LOBBY
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum RoomVisibility {
  /// Listed to everyone in-app; anyone can join freely, no password.
  PUBLIC
  /// Hidden from the public list; joining requires the room's `password`.
  PRIVATE
}

/// One played game — solo, a duel between two participants, or a room with
/// up to `ROOM_MAX_PARTICIPANTS` players. Rooms reuse the same participants
/// model with more than two rows per session.
model GameSession {
  id String @id @default(cuid())

  mode          GameMode          @default(SOLO)
  status        GameSessionStatus @default(IN_PROGRESS)
  questionCount Int

  /// 6-character code used to join a DUEL or ROOM; null for SOLO sessions.
  /// For a friend-challenge DUEL it's a fallback/share code, but only
  /// `targetUserId` (when set) may actually join via it — see
  /// `DuelService.join`. For a ROOM it's always usable to join (a PRIVATE
  /// room additionally requires `password`).
  inviteCode String? @unique

  /// Set only when this DUEL was created as a direct challenge to a
  /// specific friend (`DuelService.challenge`) rather than an open invite
  /// code anyone can join with.
  targetUserId String?

  /// Открыта для подбора: сюда посадят незнакомца, нажавшего «найти
  /// соперника». Отдельный флаг, а не «пустой targetUserId», потому что
  /// это разные намерения: создавший дуэль, чтобы отправить код другу,
  /// ждёт именно друга, и подсадить к нему постороннего было бы подменой
  /// его решения. Очередь подбора — это и есть множество таких дуэлей;
  /// отдельной таблицы под неё не нужно.
  openToMatchmaking Boolean @default(false)

  /// ROOM-only fields below — null/unused for SOLO and DUEL.
  roomName        String?
  visibility      RoomVisibility?
  /// Auto-generated, non-colliding-with-recent-passwords string required to
  /// join a PRIVATE room; null for PUBLIC rooms (and non-rooms).
  password        String?
  /// The room's creator — controls kick/ban/start. Also has a
  /// `GameParticipant.isLeader` row for the same user, kept in sync.
  leaderId        String?
  maxParticipants Int?

  /// Index (0-based) of the question currently being answered.
  currentOrder             Int       @default(0)
  /// Server timestamp when the current question was presented — the only
  /// source of truth for speed-based scoring; client-reported timings are
  /// never trusted.
  currentQuestionStartedAt DateTime?
  /// Seconds allowed per question in a duel/room; unused for SOLO.
  timeLimitSeconds         Int       @default(15)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  participants GameParticipant[]
  answers      GameAnswer[]
  roomInvites  RoomInvite[]

  @@index([targetUserId, status])
  @@index([mode, status, visibility])
  @@index([mode, status, openToMatchmaking])
  @@map("game_sessions")
}

/// One player's presence and running score within a session. SOLO sessions
/// have exactly one; DUEL sessions have exactly two.
model GameParticipant {
  id        String      @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ROOM-only: display order in the lobby/game participant list.
  joinedAt DateTime @default(now())

  correctCount Int @default(0)
  score        Int @default(0)
  /// Current streak of consecutive correct answers, reset to 0 on a miss.
  streak       Int @default(0)

  xpEarned     Int     @default(0)
  coinsEarned  Int     @default(0)
  /// Rating actually applied for this game (duels/rooms only; solo never
  /// touches rating). Zero if `ratingCapped` — the daily cap clipped it.
  ratingDelta  Int     @default(0)
  ratingCapped Boolean @default(false)

  /// ROOM-only: the creator, who controls kick/ban/start. Mirrors
  /// `GameSession.leaderId` for this row's `userId`.
  isLeader Boolean @default(false)
  /// ROOM-only: toggled by every non-leader participant before the leader
  /// can start the match. Always false once the room leaves LOBBY.
  isReady  Boolean @default(false)

  answers GameAnswer[]

  @@unique([sessionId, userId])
  @@map("game_participants")
}

/// A leader-scoped block: `bannedUserId` can never join any ROOM led by
/// `leaderId` again (existing rooms they're already in are unaffected — a
/// ban only blocks future joins). Independent of other leaders' rooms.
model RoomBan {
  id String @id @default(cuid())

  leaderId String
  leader   User   @relation("RoomBansIssued", fields: [leaderId], references: [id], onDelete: Cascade)

  bannedUserId String
  bannedUser   User   @relation("RoomBansReceived", fields: [bannedUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([leaderId, bannedUserId])
  @@map("room_bans")
}

/// A direct invite from a room's leader to one specific friend, sent from
/// the lobby's friend picker — distinct from the generic invite code/
/// password (which anyone can use), this is a personal "come join" that
/// shows up in the invited friend's pending-invites list and lets them join
/// with one tap, no code or password needed. Cleared once the room leaves
/// LOBBY (starts or closes) — see `RoomsService.start`/`close`.
model RoomInvite {
  id String @id @default(cuid())

  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User   @relation("RoomInvitesSent", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId String
  toUser   User   @relation("RoomInvitesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sessionId, toUserId])
  @@index([toUserId])
  @@map("room_invites")
}

/// One question served to one participant, in order. Created up front for
/// the whole session (per participant); filled in as they answer. In a duel
/// both participants get their own row for the same `questionId`/`order`.
model GameAnswer {
  id            String          @id @default(cuid())
  sessionId     String
  session       GameSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String
  participant   GameParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question        @relation(fields: [questionId], references: [id])

  order         Int
  selectedIndex Int?
  isCorrect     Boolean?
  answeredAt    DateTime?
  timeTakenMs   Int?
  /// Points this answer contributed to the participant's score (duels only;
  /// solo scoring is flat and doesn't need a per-question breakdown).
  scoreDelta    Int?

  /// This question's 4 options, shuffled independently per participant when
  /// the round is set up (so the answer position can't be memorized or
  /// called out to a duel opponent), with `correctIndex` remapped to match.
  /// The underlying `Question.options` order is untouched.
  shuffledOptions      String[]
  shuffledCorrectIndex Int      @default(0)

  @@unique([participantId, order])
  @@map("game_answers")
}

enum DeclineNoticeKind {
  DUEL_CHALLENGE
  ROOM_INVITE
  DICE_CHALLENGE
}

/// A one-shot "your invite was declined" notice for the person who sent it —
/// duel-challenge and room-invite declines both used to just vanish
/// silently for whoever sent them. Deleted the moment it's been shown (see
/// `NotificationsController.dismissDeclineNotice`), so this table only ever
/// holds notices still waiting to be delivered — not a permanent log.
model DeclineNotice {
  id String @id @default(cuid())

  userId String
  user   User   @relation("DeclineNoticesFor", fields: [userId], references: [id], onDelete: Cascade)

  kind DeclineNoticeKind

  declinedByUserId String
  declinedByUser   User   @relation("DeclineNoticesBy", fields: [declinedByUserId], references: [id], onDelete: Cascade)

  /// Only set for ROOM_INVITE — the room's name, since a duel challenge has
  /// no equivalent to name.
  roomName String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("decline_notices")
}

enum ErrorReportSource {
  API
  WEB
}

/// Self-reported crash/error telemetry, written automatically by the
/// backend's global exception filter (5xx responses) and by the frontend
/// (unhandled exceptions, unhandled promise rejections, React render
/// crashes, failed/5xx API calls) — a standing "what's actually breaking
/// for real users" log so problems surface here instead of depending on
/// someone noticing and relaying them by hand. Deliberately not a foreign
/// key to `User`: this must never fail to write because a user row is
/// gone, so `userId` is just an unenforced label.
model ErrorReport {
  id String @id @default(cuid())

  source ErrorReportSource

  /// Short machine tag for grouping, e.g. "unhandled_exception",
  /// "http_5xx", "client_unhandled", "client_unhandledrejection",
  /// "client_react_boundary", "api_5xx_response", "api_network_failure".
  kind String

  message String
  stack   String? @db.Text

  statusCode Int?
  path       String?
  method     String?
  userId     String?

  /// Free-form extra context: user agent, component stack, request body
  /// shape, etc. — whatever the reporting site had on hand.
  extra Json?

  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([resolved, createdAt])
  @@index([source, kind, createdAt])
  @@map("error_reports")
}

enum AbuseReportReason {
  INSULT
  SPAM
  INAPPROPRIATE
  IMPERSONATION
  OTHER
}

enum AbuseReportStatus {
  PENDING
  ACTIONED
  DISMISSED
}

/// A complaint one player files about another. Until this existed the only
/// recourse was the personal blacklist — which hides the offender from the
/// victim but tells nobody, so nothing is ever acted on. That gap is the
/// reason this table exists: it is the difference between "I can avoid
/// them" and "someone can stop them", which matters most for the youngest
/// players.
///
/// Жаловались раньше и на конкретное сообщение — тогда текст копировался
/// в жалобу, чтобы улику нельзя было стереть вместе с перепиской. Личной
/// переписки в приложении больше нет, поэтому осталась жалоба на человека:
/// за поведение в комнате, за ник, за спам приглашениями.
model AbuseReport {
  id String @id @default(cuid())

  reason  AbuseReportReason
  /// Optional free-text detail from the reporter.
  comment String?

  reporterId String
  reporter   User   @relation("AbuseReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  targetUserId String
  targetUser   User   @relation("AbuseReportsAgainst", fields: [targetUserId], references: [id], onDelete: Cascade)

  status     AbuseReportStatus @default(PENDING)
  reviewedAt DateTime?
  /// Free-text note from whoever reviewed it.
  reviewNote String?

  createdAt DateTime @default(now())

  /// One player can't file the same complaint about the same person twice —
  /// stops a brigade (or a misclick) from inflating the report count that
  /// moderation triage sorts by.
  @@unique([reporterId, targetUserId])
  @@index([status, createdAt])
  @@index([targetUserId, status])
  @@map("abuse_reports")
}

/// One row per achievement a user has unlocked.
///
/// Only unlocks are stored — progress is always recomputed from the numbers
/// the app already keeps (see `packages/shared/src/achievements.ts`). That
/// means a definition can be retuned or added at any time and every
/// existing player is measured against it retroactively, with no backfill.
///
/// `achievementId` is the string id from that file rather than a foreign
/// key: the definitions are code, not data, and a row must survive a
/// definition being renamed or temporarily removed.
model UserAchievement {
  id String @id @default(cuid())

  userId        String
  achievementId String

  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

/// Покупка в лавке — по строке на каждое списание монет.
///
/// Журнал, а не «что у игрока есть»: надетое оформление лежит в `User`,
/// запас расходников — там же счётчиком. Здесь важна история, и она нужна
/// не для красоты. Когда игрок напишет «купил рамку, а её нет» — вопрос
/// решается одной выборкой; без журнала он решается верой на слово.
///
/// `price` записывается тот, что был в момент покупки: каталог живёт в
/// коде и цены в нём меняются, а разбор старой покупки по новой цене —
/// это разбор не того, что было.
model ShopPurchase {
  id String @id @default(cuid())

  userId String
  /// Идентификатор товара из `SHOP_ITEMS`. Строкой, а не перечислением:
  /// каталог правится чаще, чем схема, и новый товар не должен требовать
  /// миграции базы.
  itemId String
  price  Int

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, itemId])
  @@map("shop_purchases")
}

/// Одно слово в колоде Alias.
///
/// `gloss` — одна строка «что это», показывается на разборе раунда по
/// нажатию: именно здесь игра тихо становится приложением о Библии, без
/// единой лекции. `reference` необязателен — у сквозных понятий вроде
/// «завет» одной честной ссылки не существует, и выдумывать её хуже, чем
/// оставить пустой.
model AliasWord {
  id String @id @default(cuid())

  word       String          @unique
  difficulty AliasDifficulty
  category   AliasCategory
  testament  AliasTestament

  gloss String

  /// Другие ответы, засчитываемые как верные: значимые части составных
  /// имён («Навин» для «Иисус Навин») и общепринятые варианты написания
  /// («Далила» для «Далиды»). Заполняется сидом — см. `seed-alias.ts`,
  /// там же правило, по которому вариант признаётся однозначным.
  accepts String[] @default([])

  /// Место в Писании, разобранное на части, а не строкой: строку нельзя ни
  /// проверить при заливке, ни превратить в переход в читалку. Все три поля
  /// либо заполнены вместе, либо пусты вместе — у сквозных слов вроде
  /// «покаяние» одного честного места нет.
  refBookId  Int?
  refChapter Int?
  refVerse   Int?

  createdAt DateTime @default(now())
  /// Когда слово правили в последний раз. Заведено вместе с правкой
  /// содержимого из приложения: без него в списке не отличить слово из
  /// первой заливки от исправленного вчера.
  updatedAt DateTime @default(now()) @updatedAt

  dailyAttempts   DailyWordAttempt[]
  hotColdAttempts HotColdAttempt[]
  hotColdNotes    HotColdFeedback[]
  hotColdDuels    HotColdDuel[]

  @@index([difficulty])
  @@index([category])
  @@map("alias_words")
}

/// Сыгранная партия. Команды хранятся как JSON с именами и счётом: почти
/// все за столом — гости без аккаунтов, и требовать регистрации от шести
/// человек ради одной партии значит её не начать. К аккаунту привязан
/// только владелец телефона.
///
/// Намеренно НЕ влияет на рейтинг «Знания»: счёт вводится вручную одним
/// человеком, накрутить его тривиально, и пускать это в общий рейтинг
/// значит испортить рейтинг.
model AliasMatch {
  id String @id @default(cuid())

  hostUserId String
  host       User   @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  /// `[{ name, score }]` в порядке хода.
  teams        Json
  winnerName   String?
  roundsPlayed Int
  /// Снимок настроек — чтобы старую партию можно было прочитать, даже если
  /// значения по умолчанию потом изменятся.
  settings     Json

  playedAt DateTime @default(now())

  @@index([hostUserId, playedAt])
  @@map("alias_matches")
}

/// Попытка игрока за один день. Одна строка на человека в сутки — она же и
/// журнал (сколько попыток, сколько подсказок), и защита от повторного
/// прохождения: уникальность по `[userId, date]`.
///
/// `date` — локальная дата игрока, а не UTC. Слово дня должно меняться в
/// его полночь, ровно как серия дней: человек в UTC+10, играющий каждый
/// вечер, иначе получал бы «завтрашнее» слово или терял день ни за что.
model DailyWordAttempt {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date   DateTime  @db.Date
  wordId String
  word   AliasWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  attemptsUsed Int       @default(0)
  hintsUsed    Int       @default(0)
  solved       Boolean   @default(false)
  /// Проставляется, когда игра за день закончена — угадал или потратил все
  /// попытки. Пока `null`, день ещё можно доиграть.
  finishedAt   DateTime?

  /// Попытки, докупленные в лавке сверх обычных пяти.
  ///
  /// Отдельным полем, а не вычитанием из `attemptsUsed`: уменьшать счётчик
  /// сделанных попыток значит потерять, сколько раз человек на самом деле
  /// отвечал, — а это то, по чему потом разбирают день.
  extraAttempts Int @default(0)

  xpEarned    Int @default(0)
  coinsEarned Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@map("daily_word_attempts")
}

/// Партия «Горячо-холодно» за один день.
///
/// Догадки лежат одним полем JSON, а не отдельной таблицей: их бывает
/// сотня за игру, читаются они всегда целиком и только своим владельцем, и
/// заводить ради этого строку на каждое слово значило бы платить за
/// возможность, которая никому не нужна.
model HotColdAttempt {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date   DateTime  @db.Date
  /// Номер партии за день. Ноль — слово дня, общее для всех; дальше идут
  /// свободные, которые игрок берёт сам, сколько захочет. Без этого поля
  /// партия была одна на день, и «ещё одну» сказать было некому.
  round  Int       @default(0)
  wordId String
  word   AliasWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  /// Массив `{ word, rank, revealed? }` по порядку появления.
  guesses Json @default("[]")

  /// Подсказки-факты: `{ kind, text }`. Соседние слова сюда не попадают —
  /// у них есть место в рейтинге, и им место в общем списке догадок. А
  /// «слово из семи букв на К» и описание загаданного местом не обладают,
  /// и класть их в список догадок значило бы врать про их рейтинг.
  hints Json @default("[]")

  /// Сдался: слово показано, партия закончена, награды нет. Отдельно от
  /// `solved`, потому что это разные исходы — и разное надо показать.
  gaveUp Boolean @default(false)

  guessCount Int       @default(0)
  hintsUsed  Int       @default(0)
  solved     Boolean   @default(false)
  /// Проставляется, когда слово угадано. Пока `null`, день можно доиграть:
  /// попытки здесь не ограничены, и «проиграть» эту игру нельзя — можно
  /// только не доиграть.
  finishedAt DateTime?

  xpEarned    Int @default(0)
  coinsEarned Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, round])
  @@index([date])
  @@map("hot_cold_attempts")
}

/// «Это слово должно быть ближе» — жалоба игрока на расстояние.
///
/// Ради неё всё и затевалось: связи в `known-links.ts` написаны из одной
/// головы, и совпадение с чужими ассоциациями ничем не доказано. Здесь
/// копятся настоящие промахи — те, что заметили живые люди, а не те, что я
/// сам придумал проверить.
model HotColdFeedback {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Загаданное слово того дня.
  wordId String
  word   AliasWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  /// Слово игрока — уже разобранное, в словарной форме.
  guess String
  /// Какое место оно занимало в момент жалобы. Нужно, чтобы отличить
  /// «стояло на трёх тысячах» от «стояло на сотне и всё равно обидно».
  rank  Int

  date      DateTime @db.Date
  createdAt DateTime @default(now())

  /// Одна жалоба на пару «загаданное — слово» в день. Загаданное входит
  /// в ключ, потому что за день партий теперь несколько: «кровь» рядом с
  /// «Каином» и «кровь» рядом с «Пасхой» — разные промахи, и второй не
  /// должен пропадать из-за первого.
  @@unique([userId, date, wordId, guess])
  @@index([wordId, guess])
  @@map("hot_cold_feedback")
}

enum HotColdDuelStatus {
  /// Создана, второй игрок ещё не зашёл.
  WAITING
  /// Оба на месте, но игра ещё не пошла: ждём «готов» от каждого.
  READY_CHECK
  IN_PROGRESS
  FINISHED
  /// Никто не пришёл, или оба ушли, не доиграв.
  ABANDONED
}

/// Дуэль «горячо-холодно»: двое ищут одно и то же слово наперегонки.
///
/// Отдельная модель, а не `GameSession`: та построена вокруг вопросов —
/// `questionCount`, `currentOrder`, таймер на вопрос, таблица ответов.
/// Здесь нет ни вопросов, ни ходов по очереди, ни таймера; общего между
/// режимами — только «двое играют вместе», и ради этого одного тащить
/// модель, у которой половина полей стала бы `null`, невыгодно.
///
/// Слово выбирается не из тех, что игроки уже сыграли сегодня в одиночку:
/// иначе один из двоих начинал бы, зная ответ.
model HotColdDuel {
  id String @id @default(cuid())

  status HotColdDuelStatus @default(WAITING)

  /// Код для присоединения. Есть всегда — даже у прямого вызова другу, где
  /// он служит запасным способом позвать, если уведомление не дошло.
  inviteCode String @unique

  /// Заполнено, если это вызов конкретному другу: тогда по коду зайдёт
  /// только он. Пусто — зайдёт любой, кому код дали.
  targetUserId String?

  /// Открыта для подбора: сюда посадят незнакомца, нажавшего «найти
  /// соперника». См. то же поле у `GameSession` — намерения «жду друга по
  /// коду» и «жду кого угодно» разные, и путать их нельзя.
  openToMatchmaking Boolean @default(false)

  wordId String
  word   AliasWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  /// Кто угадал первым. Пусто, если дуэль ещё идёт или оба сдались.
  winnerId String?

  /// Общие подсказки, уже открытые: массив строк по порядку. Одинаковые у
  /// обоих — в этом весь смысл: подсказка в гонке не должна быть форой.
  hints      Json    @default("[]")
  hintsTaken Int     @default(0)
  /// Кто предложил взять подсказку и ждёт ответа второго. Берётся она
  /// только по согласию обоих, поэтому предложение — часть состояния
  /// партии, а не сообщение, которое можно потерять.
  hintRequestedBy String?

  createdAt  DateTime  @default(now())
  /// Когда оба нажали «готов» и пошла игра (после отсчёта).
  startedAt  DateTime?
  /// Момент старта: до него идёт отсчёт «3-2-1», ходы не принимаются, часы
  /// на слово не заведены. Хранится, а не держится в памяти, потому что
  /// отсчёт должен пережить и перезагрузку страницы, и переподключение.
  startsAt   DateTime?
  finishedAt DateTime?

  players HotColdDuelPlayer[]

  @@index([targetUserId, status])
  @@index([status, createdAt])
  @@index([status, openToMatchmaking])
  @@map("hot_cold_duels")
}

/// Один игрок в дуэли. Свои догадки лежат здесь же.
///
/// Отдельная строка на игрока, а не общий список ходов, ровно затем, чтобы
/// двое писали в разные строки: гонка здесь буквальная, и два
/// одновременных хода не должны спорить за одну запись.
model HotColdDuelPlayer {
  id String @id @default(cuid())

  duelId String
  duel   HotColdDuel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Массив `{ word, rank }`. Противнику из него уезжают ТОЛЬКО числа:
  /// увидеть чужие слова значит списать их, и вся игра кончится.
  guesses Json @default("[]")

  guessCount Int  @default(0)
  /// Лучшее (наименьшее) место — им меряется, кто ближе.
  bestRank   Int?

  solvedAt      DateTime?
  /// Сдался: противник побеждает, но это не то же самое, что уйти молча.
  surrenderedAt DateTime?

  xpEarned     Int     @default(0)
  coinsEarned  Int     @default(0)
  ratingDelta  Int     @default(0)
  ratingCapped Boolean @default(false)

  joinedAt DateTime @default(now())
  /// Нажал «готов». Пока пусто хотя бы у одного — партия не начинается.
  readyAt  DateTime?

  /// Словарь: что игрок искал и что ему показали. Массив
  /// `{ query, words }` по порядку. Личное — у каждого свои поиски.
  lookups     Json @default("[]")
  lookupCount Int  @default(0)

  @@unique([duelId, userId])
  @@index([userId, duelId])
  @@map("hot_cold_duel_players")
}

/// В какой роли действовал человек. Хранится вместе с записью, а не
/// вычисляется при чтении: права меняются, а журнал должен остаться
/// таким, каким был в момент действия.
enum AdminActorRole {
  GAME_MASTER
  ADMIN
}

enum AdminActionKind {
  MUTE
  UNMUTE
  RENAME
  ADJUST_BALANCE
  DELETE_ACCOUNT
  CLOSE_SESSION
  BROADCAST
  EDIT_CONTENT
  CREATE_CONTENT
  DELETE_CONTENT
}

/// Журнал действий администратора.
///
/// Нужен не из недоверия — администратор в приложении один, — а чтобы
/// через месяц можно было ответить на вопрос «почему у игрока другой ник»
/// или «куда делись монеты». Без записи такой ответ достаётся только
/// памятью, а память к тому времени помнит правку и не помнит причину.
///
/// Внешних ключей на `users` здесь намеренно нет, ни на администратора,
/// ни на цель: самое ценное для журнала действие — удаление аккаунта, и
/// каскад стёр бы запись ровно о нём. Ники сохраняются строками на момент
/// действия по той же причине.
model AdminAction {
  id String @id @default(cuid())

  adminUserId   String
  adminNickname String?
  actorRole     AdminActorRole @default(ADMIN)

  kind AdminActionKind

  targetUserId   String?
  targetNickname String?

  /// Человеческое описание: «мут на 24 ч», «монеты +500», «ник Vasya →
  /// Vasiliy». Читается в журнале без обращения к другим полям.
  summary String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@map("admin_actions")
}

enum DiceMatchStatus {
  /// Создан, второй игрок ещё не сел за стол.
  WAITING
  IN_PROGRESS
  FINISHED
  /// Никто не пришёл, или партию бросили не доиграв.
  ABANDONED
}

/// Партия в «Кости» — см. `docs/dice.md`.
///
/// Правила живут в чистом движке (`packages/shared/src/dice-engine.ts`), а
/// здесь — только то, что должно пережить перезагрузку страницы и разрыв
/// связи. Состояние кладётся целиком в `state` одним JSON, потому что оно
/// и есть одна неделимая вещь: разложенное по колонкам, оно рано или
/// поздно рассогласуется само с собой — счёт обновился, фаза нет.
///
/// Рядом с JSON дублируются только те поля, по которым **ищут**: подбор
/// соперника и список своих партий не должны разбирать JSON построчно.
model DiceMatch {
  id String @id @default(cuid())

  /// Программа не заводится как пользователь и не попадает в рейтинги людей.
  botDifficulty String?
  version Int @default(0)
  turnStartedAt DateTime?
  botActionAt DateTime?
  lastEvents Json @default("[]")
  rematchOfId String? @unique
  targetOpponentId String?

  status DiceMatchStatus @default(WAITING)

  /// Код для приглашения друга ссылкой `?startapp=dice_<код>`.
  inviteCode String @unique

  /// Открыт для подбора: сюда посадят незнакомца, нажавшего «найти
  /// соперника». Пусто — партия только для того, кому дали код. То же
  /// разделение, что у дуэлей: «жду друга» и «жду кого угодно» — разные
  /// намерения, и путать их нельзя.
  openToMatchmaking Boolean @default(false)

  targetScore Int @default(4000)

  /// Секунды на ход; `null` — без таймера (дружеская партия).
  turnTimeLimit Int?

  /// Полное состояние партии из движка.
  state Json

  winnerId String?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  /// Последнее действие любого из игроков — по нему уборщик находит
  /// брошенные партии, не трогая те, где просто думают над риском.
  lastActionAt DateTime @default(now())

  /// Идентификатор последнего применённого действия.
  ///
  /// Сеть теряет ответы, а игрок жмёт ещё раз. Без этого повтор запроса
  /// бросает кости заново и стирает уже выпавшее — то есть отнимает у
  /// игрока честный бросок из-за плохой связи. С ним тот же
  /// идентификатор просто возвращает нынешнее состояние.
  lastActionId String?

  players DiceMatchPlayer[]
  rolls   DiceRoll[]
  actions DiceMatchAction[]

  @@index([status, openToMatchmaking, createdAt])
  @@index([status, lastActionAt])
  @@index([status, botActionAt])
  @@map("dice_matches")
}

model DiceMatchPlayer {
  id String @id @default(cuid())

  matchId String
  match   DiceMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Порядок за столом: 0 ходит первым.
  seat Int

  /// Итоги партии — чтобы статистика не пересобиралась из событий.
  score      Int @default(0)
  bustCount  Int @default(0)
  hotDiceCount Int @default(0)
  /// Лучший ход за партию: то самое «а я однажды забрал 3200».
  bestTurn   Int @default(0)

  joinedAt DateTime @default(now())

  @@unique([matchId, userId])
  @@unique([matchId, seat])
  @@index([userId])
  @@map("dice_match_players")
}

/// Долговечная защита от повтора и журнал событий. userId может быть
/// идентификатором программы, поэтому внешнего ключа на users здесь нет.
model DiceMatchAction {
  id String @id @default(cuid())
  matchId String
  match DiceMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId String
  actionId String
  payload Json
  version Int
  events Json
  createdAt DateTime @default(now())

  @@unique([matchId, userId, actionId])
  @@index([matchId, version])
  @@map("dice_match_actions")
}

/// Журнал бросков: каждый бросок, сделанный сервером.
///
/// Нужен не для игры — игра берёт кости из состояния — а для разбора.
/// «Мне не выпадало ни одной единицы за десять бросков» проверяется
/// выборкой, а не верой на слово; и если генератор когда-нибудь окажется
/// кривым, это будет видно по журналу, а не по жалобам.
model DiceRoll {
  id String @id @default(cuid())

  matchId String
  match   DiceMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String

  /// Номер хода и броска внутри хода — по ним собирается повтор партии.
  turnNumber Int
  rollNumber Int

  /// Выпавшее: массив чисел 1..6.
  dice Json

  createdAt DateTime @default(now())

  @@index([matchId, createdAt])
  @@map("dice_rolls")
}
