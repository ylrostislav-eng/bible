# PostgreSQL (used by docker-compose and Prisma)
POSTGRES_USER=bible_quiz
POSTGRES_PASSWORD=bible_quiz
POSTGRES_DB=bible_quiz
POSTGRES_PORT=5432

# Prisma connection string (apps/api)
DATABASE_URL="postgresql://bible_quiz:bible_quiz@localhost:5432/bible_quiz?schema=public"

# API (apps/api)
PORT=3001

# Web (apps/web)
NEXT_PUBLIC_API_URL="http://localhost:3001"
