# PostgreSQL (used by docker-compose and Prisma)
POSTGRES_USER=bible_arena
POSTGRES_PASSWORD=bible_arena
POSTGRES_DB=bible_arena
POSTGRES_PORT=5432

# Redis (used by docker-compose and apps/api)
REDIS_PORT=6379

# Prisma connection string (apps/api)
DATABASE_URL="postgresql://bible_arena:bible_arena@localhost:5432/bible_arena?schema=public"

# Redis connection string (apps/api)
REDIS_URL="redis://localhost:6379"

# API (apps/api)
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Telegram Bot (apps/api) - required to validate Telegram Mini App auth
# Get this from @BotFather. While empty, the app sends nothing to Telegram.
TELEGRAM_BOT_TOKEN=
# Bot API address. Only ever changed to point tests at a local stub.
TELEGRAM_API_BASE=https://api.telegram.org

# JWT session secret (apps/api) - generate a long random string for production
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=15m

# Comma-separated Telegram user ids allowed to read error telemetry and the
# moderation queue. Empty means nobody can — a safe default, not an open
# admin endpoint.
ADMIN_TELEGRAM_IDS=

# Explicit opt-in for /auth/dev-login (fixed test accounts, no Telegram
# needed). Required for local development — without it the login screen
# answers "Dev login is disabled". Never set this outside development.
ENABLE_DEV_LOGIN=true

# Web (apps/web)
NEXT_PUBLIC_API_URL="http://localhost:3001"
